# -----------------------------------------------------------------------------
# JACK AGENT BACKEND ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# PORT configuration
PORT=3000

# DATABASE
# PostgreSQL connection string
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jack_agent
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public"

# REDIS (BULLMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# SECURITY
JWT_SECRET=super_secret_jwt_key_override_in_production

# AI PROVIDERS (NEVER COMMIT REAL KEYS TO VCS)
AI_PROVIDER=OPENAI # Default provider (e.g., OPENAI, GROQ, OPENROUTER, ANTHROPIC, LOCAL)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_MODEL_ENDPOINT=http://localhost:11434/api/generate # e.g. Ollama

# TELEPHONY & REAL-TIME VOICE PIPELINE (PIPECAT / TWILIO / DEEPGRAM / CARTESIA)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SYSTEM_DID=+18005550199
PUBLIC_SERVER_URL=https://your-api.up.railway.app
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here
